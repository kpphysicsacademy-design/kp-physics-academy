rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Question bank is student-facing. Keep question reads public while teachers/admins
    // should use a protected authoring workflow for future question management.
    match /physics_questions/{questionId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Student/teacher profiles.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      // A user cannot promote themselves to teacher.
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Teacher-created concepts. Students can read; only teachers can create/edit/delete.
    match /concepts/{conceptId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
  }
}
